    "definitions": {
        "dto.CreateJobDTO": {
            "type": "object",
            "required": [
                "concurrent",
                "cronExpr",
                "jobKey",
                "jobName",
                "retryCount",
                "status",
                "timeout"
            ],
            "properties": {
                "concurrent": {
                    "description": "是否并发 0禁止 1允许",
                    "type": "integer"
                },
                "cronExpr": {
                    "description": "cron执行表达式",
                    "type": "string",
                    "maxLength": 32
                },
                "invokeTarget": {
                    "description": "执行目标：服务.方法名",
                    "type": "string",
                    "maxLength": 128
                },
                "jobGroup": {
                    "description": "任务分组",
                    "type": "string",
                    "maxLength": 64
                },
                "jobKey": {
                    "description": "任务唯一标识(不可重复)",
                    "type": "string",
                    "maxLength": 64
                },
                "jobName": {
                    "description": "任务名称",
                    "type": "string",
                    "maxLength": 64
                },
                "remark": {
                    "description": "备注说明",
                    "type": "string",
                    "maxLength": 255
                },
                "retryCount": {
                    "description": "失败重试次数",
                    "type": "integer"
                },
                "status": {
                    "description": "状态 0正常 1暂停",
                    "type": "integer"
                },
                "timeout": {
                    "description": "执行超时时间(秒)",
                    "type": "integer"
                }
            }
        },
        "dto.UpdateJobDTO": {
            "type": "object",
            "required": [
                "concurrent",
                "cronExpr",
                "id",
                "jobKey",
                "jobName",
                "retryCount",
                "status",
                "timeout"
            ],
            "properties": {
                "concurrent": {
                    "description": "是否并发 0禁止 1允许",
                    "type": "integer"
                },
                "cronExpr": {
                    "description": "cron执行表达式",
                    "type": "string",
                    "maxLength": 32
                },
                "id": {
                    "description": "主键ID",
                    "type": "string",
                    "example": "0"
                },
                "invokeTarget": {
                    "description": "执行目标：服务.方法名",
                    "type": "string",
                    "maxLength": 128
                },
                "jobGroup": {
                    "description": "任务分组",
                    "type": "string",
                    "maxLength": 64
                },
                "jobKey": {
                    "description": "任务唯一标识(不可重复)",
                    "type": "string",
                    "maxLength": 64
                },
                "jobName": {
                    "description": "任务名称",
                    "type": "string",
                    "maxLength": 64
                },
                "remark": {
                    "description": "备注说明",
                    "type": "string",
                    "maxLength": 255
                },
                "retryCount": {
                    "description": "失败重试次数",
                    "type": "integer"
                },
                "status": {
                    "description": "状态 0正常 1暂停",
                    "type": "integer"
                },
                "timeout": {
                    "description": "执行超时时间(秒)",
                    "type": "integer"
                }
            }
        },
        "response.Response": {
            "type": "object",
            "properties": {
                "args": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "code": {
                    "type": "integer"
                },
                "data": {},
                "message": {
                    "type": "string"
                }
            }
