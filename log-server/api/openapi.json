{
  "openapi": "3.0.3",
  "info": {
    "title": "Aevons System Server API",
    "version": "1.0.0",
    "description": "system-server test api document"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "responses": {
          "200": {
            "description": "service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "service": {
                      "type": "string",
                      "example": "sys-server"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/test/ping": {
      "get": {
        "summary": "Test Ping",
        "responses": {
          "200": {
            "description": "test route response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "OK"
                    },
                    "message": {
                      "type": "string",
                      "example": "pong"
                    },
                    "service": {
                      "type": "string",
                      "example": "sys-server"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
